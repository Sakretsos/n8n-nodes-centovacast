{
	"name": "n8n-nodes-centovacast",
	"version": "0.2.2",
	"description": "n8n community node for Centova Cast streaming server management API",
	"license": "MIT",
	"homepage": "https://github.com/Sakretsos/n8n-nodes-centovacast",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"centovacast",
		"centova",
		"streaming",
		"radio",
		"shoutcast",
		"icecast"
	],
	"author": {
		"name": "Ioannis Tavernarakis",
		"email": "ioannis@tavernarakis.eu"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Sakretsos/n8n-nodes-centovacast.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CentovaCastApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CentovaCast/CentovaCast.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
