{
	"name": "n8n-nodes-centovacast",
	"version": "0.1.9",
	"description": "n8n community node for Centova Cast streaming server management API",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"centovacast",
		"centova",
		"streaming",
		"radio",
		"shoutcast",
		"icecast"
	],
	"license": "MIT",
	"author": {
		"name": "Ioannis Tavernarakis",
		"email": "ioannis@tavernarakis.eu"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Sakretsos/n8n-nodes-centovacast.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "tsc && node copy-icons.js",
		"dev": "tsc --watch",
		"prepublishOnly": "npm run build",
		"lint": "tsc --noEmit",
		"test": "echo \"No tests yet\" && exit 0"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/CentovaCastApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CentovaCast/CentovaCast.node.js"
		]
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.10.0",
		"@types/node": "^20.0.0",
"n8n-workflow": "^1.0.0",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
